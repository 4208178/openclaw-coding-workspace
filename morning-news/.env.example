# 晨间速递 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# 邮件配置 (SMTP)
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email@qq.com
SMTP_PASS=your_auth_code

# 企业微信 Webhook (可选)
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 备用新闻源 API Key (可选)
NEWS_API_KEY=

# 服务器配置
PORT=3000
NODE_ENV=development
