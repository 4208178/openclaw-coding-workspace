# 邮件通知配置 (email-notification)
# 复制此文件为 .env 并填入您的 SMTP 信息

# SMTP 服务器地址 (例如: smtp.gmail.com, smtp.qq.com)
SMTP_SERVER=smtp.example.com

# SMTP 端口 (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP 用户名 (通常是您的邮箱地址)
SMTP_USER=your_email@example.com

# SMTP 密码 (建议使用应用专用密码，而非主密码)
SMTP_PASS=your_app_password

# 发件人显示名称 (可选)
SMTP_FROM=CTO Bot <your_email@example.com>

# CEO 邮箱 (收件人)
SMTP_TO=ceo@example.com